# Créer le token API Zammad dans le profil Zammad (avatar -> "Jeton d'accès API")
ZAMMAD_URL=http://localhost:8080
ZAMMAD_TOKEN=inserer_votre_token

# Secret du webhook entrant (Bearer + signature HMAC SHA1).
# Générer une valeur aléatoire, ex. : openssl rand -hex 32
# Puis la coller ici ET dans le formulaire du webhook Zammad
# ("Bearer Token" et/ou "Signature HMAC SHA1 du jeton").
WEBHOOK_SECRET=
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=8
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Cache Hugging Face des modèles whisper (dossier local)
# HF_HOME=/.hf-cache
# Désactiver xet si l'environnement est bloquant (bugs de téléchargement)
# HF_HUB_DISABLE_XET=1