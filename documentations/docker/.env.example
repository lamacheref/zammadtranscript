# ===================== Zammad-Auto-Transcription =====================
# Configuration du déploiement Docker (images GHCR, sans build local).
# Copier ce fichier vers ".env" du dossier d'exécution, compléter, puis :
#   docker compose up -d
#
# Pour utiliser un tag précis de l'image (ex: "0.2.0" ou "main") :
#   ZAT_IMAGE_TAG=0.2.0 docker compose up -d

# ----- Zammad -----
# Créer le token API Zammad dans le profil Zammad (avatar -> "Jeton d'accès API")
ZAMMAD_URL=http://zammad:8080
ZAMMAD_TOKEN=Inscriver_votre_token

# Secret HMAC / Bearer utilisé pour la validation du webhook entrant.
# Générer une valeur aléatoire, ex. : openssl rand -hex 32
# Puis la coller ici ET dans le formulaire du webhook Zammad
# ("Bearer Token" et/ou "Signature HMAC SHA1 du jeton").
WEBHOOK_SECRET=

# ----- Application -----
# Tag de l'image GHCR (defaut: latest)
ZAT_IMAGE_TAG=latest
# Port d'exposition HTTP de l'interface web/webhook
WEB_PORT=8000

# ----- Transcription (faster-whisper) -----
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4

# ----- LLM (Ollama) -----
OLLAMA_MODEL=llama3.2

# ----- Divers -----
LOG_LEVEL=INFO
REDIS_PORT=6379
OLLAMA_PORT=11434